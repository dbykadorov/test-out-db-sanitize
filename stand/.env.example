# Свои источники подключаются одной строкой здесь. Скопируйте файл в .env
# и раскомментируйте нужное - каталог контура на эти переменные уже ссылается,
# перезапускать ничего не нужно, воркер перечитывает его раз в 15 секунд.
#
# Файл .env в репозиторий не попадает: учётные данные остаются у вас.

# --- Своя база вместо демонстрационной -------------------------------------
# Появится как источник my-source.
# Учётная запись нужна только на чтение: прогон в источник не пишет.
#MY_SOURCE_DSN=Host=192.168.1.10;Port=5432;Username=readonly;Password=секрет;Database=prod

# --- Свой дамп --------------------------------------------------------------
# Положите файл в stand/inbox/ и укажите здесь его ИМЯ. Появится как my-dump.
# Форматы: pg_dump -Fc, каталог -Fd, обычный текстовый .sql.
#MY_DUMP_FILE=customer.dump

# --- Свой приёмник вместо демонстрационного --------------------------------
# Появится как приёмник my-sink. Эта база ПЕРЕЗАПИСЫВАЕТСЯ прогоном:
# схема в ней удаляется и создаётся заново.
#MY_SINK_DSN=Host=192.168.1.11;Port=5432;Username=postgres;Password=секрет;Database=sanitized
